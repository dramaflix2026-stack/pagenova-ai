# =============================================================================
# Stavo Digital - variaveis de ambiente
# Copie para .env e preencha no SERVIDOR. Nunca versione o .env preenchido.
# Nenhum valor real de segredo pode existir neste arquivo de exemplo.
# =============================================================================

# --- Aplicacao -----------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
APP_URL=http://localhost:5173
APP_NAME=Stavo Digital
APP_TIMEZONE=America/Sao_Paulo
# Ative apenas quando a aplicacao estiver atras do proxy reverso da hospedagem.
TRUST_PROXY=false

# --- Banco de dados MySQL (Hostinger) ------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=stavo_crm
DB_USER=stavo_crm
DB_PASSWORD=
DB_SSL=false

# --- Sessao --------------------------------------------------------------
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Minimo de 32 caracteres. A aplicacao recusa iniciar em producao com valor fraco.
SESSION_SECRET=
SESSION_IDLE_MINUTES=720
SESSION_ABSOLUTE_HOURS=720

# --- Administrador unico -------------------------------------------------
ADMIN_EMAIL=stavodigital123@gmail.com
# Segredo TEMPORARIO de bootstrap. Use apenas para criar o administrador e
# remova a variavel do ambiente em seguida. Minimo de 12 caracteres.
ADMIN_INITIAL_PASSWORD=

# --- Google Places API (New) ---------------------------------------------
# A chave fica SOMENTE no servidor e nunca e enviada ao navegador.
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_LANGUAGE=pt-BR
GOOGLE_PLACES_REGION=BR
GOOGLE_TEXT_SEARCH_MONTHLY_HARD_LIMIT=900
GOOGLE_DETAILS_MONTHLY_HARD_LIMIT=900
GOOGLE_USAGE_WARNING_PERCENT=80

# --- Importacao ----------------------------------------------------------
MAX_IMPORT_FILE_MB=10
MAX_IMPORT_ROWS=5000

# --- Cron opcional da hospedagem -----------------------------------------
# Protege POST /api/jobs/recurrences. Deixe vazio para desabilitar o endpoint.
CRON_SECRET=

# --- Logs ----------------------------------------------------------------
LOG_LEVEL=info

# --- Sites com IA --------------------------------------------------------
# Modulo nasce DESLIGADO. Ligue apenas quando quiser usa-lo.
SITE_AI_ENABLED=false
# Modo de teste: fixture deterministica, sem custo, marcada na interface.
# Sem chave e sem mock, a interface funciona e gerar fica bloqueado com
# diagnostico -- nunca simulado em silencio.
SITE_AI_MOCK_MODE=false
SITE_AI_PROVIDER=anthropic

# A chave fica SOMENTE no servidor e nunca vai ao navegador.
ANTHROPIC_API_KEY=
# So preencher se a chave for "multi-workspace" (pessoal/conta de servico
# ligada a mais de um workspace no console) -- nesse caso a API recusa a
# chamada sem isto. ID no formato wrkspc_... , em Settings > Workspaces.
ANTHROPIC_WORKSPACE_ID=
# Ids de modelo sao configuraveis de proposito: modelo novo nao exige deploy.
ANTHROPIC_SITE_MODEL=claude-opus-5
ANTHROPIC_FAST_MODEL=claude-haiku-4-5
# Esforco da geracao: low | medium | high | xhigh | max. medium equilibra
# qualidade e custo no modo demonstracao.
ANTHROPIC_SITE_EFFORT=medium
# spec-v2 (padrao, structured outputs + cache) ou plan-v1 (formato antigo,
# para voltar atras sem deploy).
SITE_AI_GENERATOR=spec-v2
# Fonte dos sites gerados: google (padrao) ou none (so fontes do sistema).
SITE_FONTS_SOURCE=google

# --- Garimpoo (busca de leads vendida com a comunidade) -------------------
# Modulo nasce DESLIGADO. Ligue quando o subdominio estiver apontado.
GARIMPOO_ENABLED=false
GARIMPOO_HOST=garimpoo.seudominio.com.br
# Segredo combinado no webhook da Cakto. Sem ele o webhook recusa tudo.
CAKTO_WEBHOOK_SECRET=
GARIMPOO_DAILY_SEARCH_LIMIT=30
GARIMPOO_SESSION_DAYS=30
GARIMPOO_ACTIVATION_HOURS=168
ANTHROPIC_MAX_OUTPUT_TOKENS=32000
ANTHROPIC_TIMEOUT_MS=180000

# Geracao de imagens e OPCIONAL. Sem isto o modulo funciona normalmente.
OPENAI_API_KEY=
OPENAI_IMAGE_PRIMARY_MODEL=gpt-image-1
OPENAI_IMAGE_ECONOMY_MODEL=gpt-image-1-mini
OPENAI_IMAGE_TIMEOUT_MS=120000
SITE_IMAGE_GENERATION_ENABLED=false
SITE_IMAGE_PROVIDER=openai

# Origem que serve o site publicado. Vazio usa APP_URL + /p/<slug>.
PUBLIC_SITES_BASE_URL=
PUBLIC_SITES_HOST_ALLOWLIST=
SITE_PUBLIC_STORAGE_DRIVER=local
# Diretorio PERSISTENTE. Nunca /tmp e nunca dentro de dist/: os sites
# publicados sumiriam no proximo deploy.
SITE_PUBLIC_ASSETS_DIR=storage/sites
# Uploads e imagens ANTES de publicar. Diretorio proprio, separado do acima.
SITE_ASSETS_DIR=storage/site-assets
MAX_SITE_ASSET_UPLOAD_MB=8

# Orcamento. O backend tem tetos proprios e ignora valor maior que eles.
SITE_AI_MONTHLY_BUDGET_USD=50
SITE_AI_DEFAULT_PROJECT_BUDGET_USD=2
SITE_AI_MAX_GENERATION_ATTEMPTS=2
SITE_AI_MAX_REPAIR_ATTEMPTS=1
# Teto de custo de UMA chamada (pior caso, calculado antes de enviar).
SITE_AI_MAX_COST_PER_CALL_USD=1.5
# Geracoes e regeracoes permitidas por projeto a cada 24 horas.
SITE_AI_MAX_GENERATIONS_PER_PROJECT_PER_DAY=5
SITE_AI_JOB_CONCURRENCY=1
