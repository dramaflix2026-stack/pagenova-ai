# Railway frontend: full monorepo context required for CRM integration tests
FROM node:24-bookworm-slim
WORKDIR /workspace
COPY . .
# Build the embedded CRM from its current source on every frontend deployment.
# Previously Next.js served committed, stale /public/stavo-crm bundles, so CRM
# source fixes never reached production despite successful Railway deployments.
WORKDIR /workspace/frontend
RUN npm ci --no-audit --no-fund --loglevel=verbose --fetch-retries=2 --fetch-timeout=120000

# Next.js embeds NEXT_PUBLIC_* variables into browser bundles at build time.
ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
ENV NEXT_PUBLIC_SUPABASE_URL=${NEXT_PUBLIC_SUPABASE_URL}
ENV NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=${NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY}
# Stream test and TypeScript failures directly to Railway build logs for diagnosis.
RUN bash -o pipefail -c 'npm run build 2>&1 | tee /dev/stderr'
# Build CRM only after the protected frontend template validation has completed.
# The CRM sync-frigolog step updates the shared template file in the build layer.
WORKDIR /workspace/modules/stavo-crm
RUN npm ci --ignore-scripts --no-audit --no-fund --fetch-retries=2 --fetch-timeout=120000
RUN npm run build:client && rm -rf /workspace/frontend/public/stavo-crm && mkdir -p /workspace/frontend/public/stavo-crm && cp -a dist/client/. /workspace/frontend/public/stavo-crm/
WORKDIR /workspace/frontend
ENV NODE_ENV=production
ENV HOSTNAME=0.0.0.0
EXPOSE 8000
CMD ["sh", "-c", "npx next start -H 0.0.0.0 -p ${PORT:-8000}"]
