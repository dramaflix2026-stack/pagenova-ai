# Railway frontend: full monorepo context required for CRM integration tests
FROM node:24-bookworm-slim
# The cloner needs a real browser to render JavaScript-driven landing pages.
# Install Chromium and its runtime libraries in the production image.
RUN apt-get update && apt-get install -y --no-install-recommends chromium ca-certificates fonts-liberation fonts-noto-color-emoji && rm -rf /var/lib/apt/lists/*
ENV PAGENOVA_CHROMIUM_EXECUTABLE=/usr/bin/chromium
WORKDIR /workspace
COPY . .
# Build the embedded CRM from its current source on every frontend deployment.
# Previously Next.js served committed, stale /public/stavo-crm bundles, so CRM
# source fixes never reached production despite successful Railway deployments.
WORKDIR /workspace/frontend
RUN npm ci --no-audit --no-fund --loglevel=warn --fetch-retries=2 --fetch-timeout=120000

# Next.js embeds NEXT_PUBLIC_* variables into browser bundles at build time.
ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
ENV NEXT_PUBLIC_SUPABASE_URL=${NEXT_PUBLIC_SUPABASE_URL}
ENV NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=${NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY}
# Isolate full TypeScript validation before Next.js production build.
# Keep strict checking and all approved template gates enabled; emit the exact
# compiler errors independently of Next.js / its worker process.
RUN node scripts/build-universal-utilities.mjs && node scripts/install-frigolog.mjs && npx next typegen
RUN npx tsc --noEmit --pretty false --incremental false
# Explicitly validate safe public LP cutover, legacy checkout guard and Pixel routing.
RUN node --test scripts/test-marketing-landing-migration.mjs
# Stream test and TypeScript failures directly to Railway build logs for diagnosis.
# Stream build test failures directly to Railway without duplicating or hiding output.
RUN echo '[PageNova CI] Starting all mandatory frontend regressions and production Next.js build' && npm run build
# Build CRM only after the protected frontend template validation has completed.
# The CRM sync-frigolog step updates the shared template file in the build layer.
WORKDIR /workspace/modules/stavo-crm
RUN npm ci --ignore-scripts --no-audit --no-fund --fetch-retries=2 --fetch-timeout=120000
RUN npm run build:client && rm -rf /workspace/frontend/public/stavo-crm && mkdir -p /workspace/frontend/public/stavo-crm && cp -a dist/client/. /workspace/frontend/public/stavo-crm/
WORKDIR /workspace/frontend
ENV NODE_ENV=production
ENV HOSTNAME=0.0.0.0
EXPOSE 8000
CMD ["sh", "-c", "npx next start -H 0.0.0.0 -p ${PORT:-8000}"]
