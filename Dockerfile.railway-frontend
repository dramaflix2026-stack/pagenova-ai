# Landing QA service only. The production frontend uses main's full QA pipeline.
FROM node:24-bookworm-slim
WORKDIR /workspace/frontend
# Preserve dependency layer cache when changing landing components.
COPY frontend/package.json frontend/package-lock.json ./
RUN --mount=type=cache,id=pagenova-landing-npm,target=/root/.npm npm ci --no-audit --no-fund
WORKDIR /workspace
COPY . .
WORKDIR /workspace/frontend
ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
ENV NEXT_PUBLIC_SUPABASE_URL=${NEXT_PUBLIC_SUPABASE_URL}
ENV NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=${NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY}
# Generate required build assets, skip unrelated regression tests in isolated QA only.
RUN node scripts/build-universal-utilities.mjs && node scripts/install-frigolog.mjs && node scripts/build-stavo-crm.mjs && npx next build
ENV NODE_ENV=production
ENV HOSTNAME=0.0.0.0
EXPOSE 8000
CMD ["sh", "-c", "npx next start -H 0.0.0.0 -p ${PORT:-8000}"]
